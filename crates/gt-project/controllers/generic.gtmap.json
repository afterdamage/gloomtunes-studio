{
  "name": "Generic controller",
  "ports": [],
  "controls": [
    { "name": "Knob 1", "type": "knob", "cc": 21, "param": "channel/selected/volume" },
    { "name": "Knob 2", "type": "knob", "cc": 22, "param": "channel/selected/pan" },
    { "name": "Knob 3", "type": "knob", "cc": 23,
      "param": ["channel/selected/synth/filter.cutoff", "channel/selected/cutoff"] },
    { "name": "Knob 4", "type": "knob", "cc": 24,
      "param": ["channel/selected/synth/filter.resonance", "channel/selected/resonance"] },
    { "name": "Knob 5", "type": "knob", "cc": 25,
      "param": ["channel/selected/synth/amp.attack", "channel/selected/attack"] },
    { "name": "Knob 6", "type": "knob", "cc": 26,
      "param": ["channel/selected/synth/amp.decay", "channel/selected/decay"] },
    { "name": "Knob 7", "type": "knob", "cc": 27,
      "param": ["channel/selected/synth/amp.sustain", "channel/selected/sustain"] },
    { "name": "Knob 8", "type": "knob", "cc": 28,
      "param": ["channel/selected/synth/amp.release", "channel/selected/release"] },
    { "name": "Fader 1", "type": "fader", "channel": 1, "cc": 7, "param": "mixer/1/volume" },
    { "name": "Fader 2", "type": "fader", "channel": 2, "cc": 7, "param": "mixer/2/volume" },
    { "name": "Fader 3", "type": "fader", "channel": 3, "cc": 7, "param": "mixer/3/volume" },
    { "name": "Fader 4", "type": "fader", "channel": 4, "cc": 7, "param": "mixer/4/volume" },
    { "name": "Fader 5", "type": "fader", "channel": 5, "cc": 7, "param": "mixer/5/volume" },
    { "name": "Fader 6", "type": "fader", "channel": 6, "cc": 7, "param": "mixer/6/volume" },
    { "name": "Fader 7", "type": "fader", "channel": 7, "cc": 7, "param": "mixer/7/volume" },
    { "name": "Fader 8", "type": "fader", "channel": 8, "cc": 7, "param": "mixer/8/volume" },
    { "name": "Master", "type": "fader", "channel": 16, "cc": 7, "param": "mixer/0/volume" },
    { "name": "Previous channel", "type": "button", "cc": 112, "transport": "prev-channel" },
    { "name": "Next channel", "type": "button", "cc": 113, "transport": "next-channel" },
    { "name": "Metronome", "type": "button", "cc": 114, "transport": "metronome" },
    { "name": "Loop", "type": "button", "cc": 115, "transport": "loop" },
    { "name": "Previous pattern", "type": "button", "cc": 116, "transport": "prev-pattern" },
    { "name": "Stop", "type": "button", "cc": 117, "transport": "stop" },
    { "name": "Play", "type": "button", "cc": 118, "transport": "play" },
    { "name": "Record", "type": "button", "cc": 119, "transport": "record" }
  ]
}
